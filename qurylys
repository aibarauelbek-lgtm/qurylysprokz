    let currentLang="kk";
    const $=(id)=>document.getElementById(id);
    function setLanguage(lang){
      currentLang=lang;document.documentElement.lang=lang;
      document.querySelectorAll("[data-i18n]").forEach(el=>{const key=el.dataset.i18n;if(translations[lang][key])el.innerHTML=translations[lang][key]});
      $("langBtn").textContent=lang==="kk"?"RU":"KZ";
      $("clientName").placeholder=translations[lang].namePlaceholder;
      $("clientMessage").placeholder=translations[lang].messagePlaceholder;
    }
    $("langBtn").addEventListener("click",()=>setLanguage(currentLang==="kk"?"ru":"kk"));
    $("menuBtn").addEventListener("click",()=>$("navLinks").classList.toggle("open"));
    document.querySelectorAll(".nav-links a").forEach(a=>a.addEventListener("click",()=>$("navLinks").classList.remove("open")));
    function setupContacts(){
      const configured=CONFIG.whatsappNumber && !CONFIG.whatsappNumber.includes("X");
      $("phoneText").textContent=CONFIG.phoneDisplay;
      if(CONFIG.phoneLink){$("phoneLink").href="tel:"+CONFIG.phoneLink.replace(/[^\d+]/g,"");}
      else $("phoneLink").addEventListener("click",e=>{e.preventDefault();alert(currentLang==="kk"?"Телефон нөмірі әлі енгізілмеген.":"Номер телефона пока не указан.");});
      if(configured){$("waLink").href="https://wa.me/"+CONFIG.whatsappNumber.replace(/\D/g,"");}
      else $("waLink").addEventListener("click",e=>{e.preventDefault();alert(translations[currentLang].numberMissing);});
      $("contactForm").addEventListener("submit",e=>{
        e.preventDefault();
        if(!configured){alert(translations[currentLang].numberMissing);return;}
        const name=$("clientName").value.trim(),phone=$("clientPhone").value.trim(),message=$("clientMessage").value.trim();
        const body=currentLang==="kk"
          ?`Сәлеметсіз бе! QURYLYS PRO сайты арқылы хабарласып тұрмын.\nАты: ${name}\nТелефон: ${phone}\nҚызмет: ${message}`
          :`Здравствуйте! Пишу с сайта QURYLYS PRO.\nИмя: ${name}\nТелефон: ${phone}\nУслуга: ${message}`;
        window.open("https://wa.me/"+CONFIG.whatsappNumber.replace(/\D/g,"")+"?text="+encodeURIComponent(body),"_blank","noopener");
      });
    }
